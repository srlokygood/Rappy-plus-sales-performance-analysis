      <aliases enabled='yes' />
      <column caption='Last Year' datatype='real' name='[Calculation_1316721304080384]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(SUM([monto_total]), -12)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Total Profit orders' datatype='real' name='[Calculation_1316721304342529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([monto_total])&#13;&#10;-&#13;&#10;SUM([costo_unitario] * [cantidad])' />
      </column>
      <column caption='net profit' datatype='real' name='[Calculation_1316721342775298]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1316721304342529] - SUM([gasto])' />
      </column>
      <column caption='Total cost marketing' datatype='real' name='[Calculation_1316721344012291]' role='measure' type='quantitative'>
